# Papers the developer supplied: copyrighted, stay local
docs/papers/

# Icon comparison board: embeds third-party icons (MIT and CC BY sets). Kept local.
docs/concepts/IconCompare.dc.html
docs/concepts/previews/icon-compare.png

# Secrets: never commit
.devcontainer/.env
*.jks
*.keystore
key.properties

# Miscellaneous
*.log
*.pyc
__pycache__/
*.swp
.DS_Store
.idea/
*.iml

# .vscode is committed on purpose (tasks and launch configurations).

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication and obfuscation related
app.*.symbols
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Core dumps (e.g. from a crashed emulator)
core.[0-9]*

# Built APKs copied for installing (scripts/build-apk.sh)
/dist/

# Release signing key, base64 copy for the GitHub secret
*.jks.base64
