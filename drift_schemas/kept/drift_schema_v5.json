    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "people",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"people\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"contact_id\" TEXT NULL, \"closeness\" TEXT NOT NULL, \"reconnecting\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reconnecting\" IN (0, 1)), \"rhythm_days\" INTEGER NULL, \"main_messenger\" TEXT NULL, \"phone\" TEXT NULL, \"telegram_username\" TEXT NULL, \"signal_link\" TEXT NULL, \"discord_user_id\" TEXT NULL, \"birthday_month\" INTEGER NULL, \"birthday_day\" INTEGER NULL, \"birthday_year\" INTEGER NULL, \"avatar_shape\" TEXT NOT NULL, \"avatar_color\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"reply_cleared_at\" INTEGER NULL, \"nickname\" TEXT NULL, \"photo\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"groups\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "group_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"group_members\" (\"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id) ON DELETE CASCADE, \"person_id\" TEXT NOT NULL REFERENCES people (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"group_id\", \"person_id\"));"
        }
      ]
    },
    {
      "name": "intentions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intentions\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NULL REFERENCES people (id) ON DELETE CASCADE, \"group_id\" TEXT NULL REFERENCES \"groups\" (id) ON DELETE CASCADE, \"note\" TEXT NOT NULL DEFAULT '', \"kind\" TEXT NOT NULL DEFAULT 'write', \"state\" TEXT NOT NULL DEFAULT 'open', \"link\" TEXT NULL, \"date\" INTEGER NULL, \"horizon\" TEXT NULL, \"condition\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK ((person_id IS NULL) <> (group_id IS NULL)));"
        }
      ]
    },
    {
      "name": "contact_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"contact_events\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NOT NULL REFERENCES people (id) ON DELETE CASCADE, \"at\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"activity\" TEXT NULL, \"note\" TEXT NULL, \"intention_id\" TEXT NULL REFERENCES intentions (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"activity_icon\" TEXT NULL, \"group_id\" TEXT NULL REFERENCES \"groups\" (id) ON DELETE SET NULL, \"shared_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "day_answers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_answers\" (\"day\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"answered_at\" INTEGER NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "treats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"treats\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"stamps_needed\" INTEGER NOT NULL, \"state\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"earned_at\" INTEGER NULL, \"enjoyed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
