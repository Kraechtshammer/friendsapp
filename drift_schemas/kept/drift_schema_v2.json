    {
      "name": "people",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"people\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"contact_id\" TEXT NULL, \"closeness\" TEXT NOT NULL, \"reconnecting\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reconnecting\" IN (0, 1)), \"rhythm_days\" INTEGER NULL, \"main_messenger\" TEXT NULL, \"phone\" TEXT NULL, \"telegram_username\" TEXT NULL, \"signal_link\" TEXT NULL, \"discord_user_id\" TEXT NULL, \"birthday_month\" INTEGER NULL, \"birthday_day\" INTEGER NULL, \"birthday_year\" INTEGER NULL, \"avatar_shape\" TEXT NOT NULL, \"avatar_color\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "intentions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intentions\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NOT NULL REFERENCES people (id) ON DELETE CASCADE, \"note\" TEXT NOT NULL DEFAULT '', \"kind\" TEXT NOT NULL DEFAULT 'write', \"state\" TEXT NOT NULL DEFAULT 'open', \"link\" TEXT NULL, \"date\" INTEGER NULL, \"horizon\" TEXT NULL, \"condition\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
